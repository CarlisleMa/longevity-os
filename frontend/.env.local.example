# Copy to .env.local. Base URL of the LongevityOS backend.
# Local dev:   http://localhost:8000
# Production:  set NEXT_PUBLIC_API_BASE to your deployed backend URL on Vercel,
#              e.g. https://longevityos-api.onrender.com
#              (read at build time — redeploy the frontend after changing it).
NEXT_PUBLIC_API_BASE=http://localhost:8000
