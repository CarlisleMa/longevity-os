# ── Data: never commit real personal or AI-READI participant data ──
# (AI-READI data use agreement forbids redistribution. Demo users are synthetic.)
data/users/
data/uploads/
*.dcm
*.edf
*.wfdb
*.hea
*.dat

# ── Model weights (local-only, large) ──
model_artifacts/weights/
*.pth
*.bin
*.onnx
*.safetensors

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ── Node / Next.js frontend ──
node_modules/
.next/
out/
.turbo/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Secrets / env ──
.env
.env.local
.env.*.local
*.key
*.pem
credentials*

# ── Generated artifacts ──
backend/.cache/
engine/**/artifacts/
engine/**/logs/
*.sqlite

# ── OS / IDE ──
.DS_Store
Thumbs.db
.vscode/
.idea/
# Local Claude Code config — ignore everything except committed, reusable skills
.claude/*
!.claude/skills/
.codex

# ── Remotion video build (large / re-renderable / generated) ──
video/node_modules/
video/out/
video/.remotion/
video/public/audio/*.mp3
